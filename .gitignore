# =====================================================================
# kafka_rev1 — repository root .gitignore
# The producer/ and consumer/ modules also carry their own .gitignore
# (generated by Spring Initializr) for module-local build/IDE output.
# =====================================================================

# ---- Build output ----
target/
build/
out/
*.class

# ---- IDE / editor ----
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project

# ---- OS noise ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs ----
*.log
logs/

# ---- Secrets & local-only config (NEVER commit credentials) ----
# Real broker passwords / API keys belong in env vars or a secrets manager.
.env
*.env
application-local.yaml
application-local.yml
application-local.properties
application-*-local.yaml
*-secrets.yaml
secrets/

# ---- Local Kafka data (only relevant if a volume is added to docker-compose) ----
kafka-data/

# AI agent config
.clinerules

#temp
consumer/
producer/